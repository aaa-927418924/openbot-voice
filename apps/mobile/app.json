{
  "expo": {
    "name": "OpenBot",
    "slug": "openbot",
    "platforms": ["ios", "android"],
    "version": "1.1.3",
    "orientation": "portrait",
    "icon": "./assets/icons/app-icon.png",
    "scheme": "openbot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "run.openbot.mobile",
      "supportsTablet": true,
      "requireFullScreen": false,
      "associatedDomains": ["applinks:openbot.run"],
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "NSLocalNetworkUsageDescription": "Allow OpenBot to connect to your desktop during local development.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "100.64.0.0/10": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "fd7a:115c:a1e0::/48": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          },
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/icons/app-icon.icon",
      "buildNumber": "4"
    },
    "android": {
      "package": "run.openbot.mobile",
      "icon": "./assets/icons/app-icon.png",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "plugins": [
      "./plugins/with-rocketsim",
      "expo-router",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E6C5FA",
          "image": "./assets/icons/app-icon.png",
          "imageWidth": 112,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#181818"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow OpenBot to use your camera to scan QR codes.",
          "microphonePermission": "Allow OpenBot to use the microphone for voice conversations and dictation.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow OpenBot to access the photos you choose to share.",
          "cameraPermission": "Allow OpenBot to use your camera to add photos.",
          "microphonePermission": "Allow OpenBot to use the microphone for voice conversations and dictation."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow OpenBot to access the photos you choose to share.",
          "savePhotosPermission": "Allow OpenBot to save images you download from a chat to your photo library.",
          "granularPermissions": ["photo"]
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-sharing",
      "expo-font",
      "expo-image",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow OpenBot to use the microphone for voice conversations and dictation.",
          "speechRecognitionPermission": "Allow OpenBot to turn your speech into message text."
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "run.openbot.mobile.ExpoWidgetsTarget",
          "groupIdentifier": "group.run.openbot.mobile",
          "enablePushNotifications": true,
          "frequentUpdates": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": false
    }
  }
}

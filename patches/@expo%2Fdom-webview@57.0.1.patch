index 0000000000000000000000000000000000000000..92d67d8a96d7b772fd72fd9c7a42f2553c6cfaf2
--- /dev/null
+++ b/android/src/test/java/expo/modules/webview/DomWebViewPermissionPolicyTest.kt
@@ -0,0 +1,75 @@
+package expo.modules.webview
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class DomWebViewPermissionPolicyTest {
+  private val audioCapture = "android.webkit.resource.AUDIO_CAPTURE"
+  private val embeddedDom = "file:///android_asset/www.bundle/live-voice.html"
+
+  @Test
+  fun `grants audio to the current embedded app DOM page when Android permission is granted`() {
+    assertTrue(
+      DomWebViewPermissionPolicy.mayGrantAudioCapture(
+        arrayOf(audioCapture), true, embeddedDom, embeddedDom, "file://", audioCapture
+      )
+    )
+  }
+
+  @Test
+  fun `grants audio to the current Expo DOM development page`() {
+    val devDom = "http://192.168.1.20:8081/_expo/@dom/live-voice.html"
+    assertTrue(
+      DomWebViewPermissionPolicy.mayGrantAudioCapture(
+        arrayOf(audioCapture), true, devDom, devDom, "http://192.168.1.20:8081", audioCapture
+      )
+    )
+  }
+
+  @Test
+  fun `denies audio when the Android microphone permission is not granted`() {
+    assertFalse(
+      DomWebViewPermissionPolicy.mayGrantAudioCapture(
+        arrayOf(audioCapture), false, embeddedDom, embeddedDom, "file://", audioCapture
+      )
+    )
+  }
+
+  @Test
+  fun `denies requests for any resource other than audio capture alone`() {
+    assertFalse(
+      DomWebViewPermissionPolicy.mayGrantAudioCapture(
+        arrayOf("android.webkit.resource.VIDEO_CAPTURE"), true, embeddedDom, embeddedDom, "file://", audioCapture
+      )
+    )
+    assertFalse(
+      DomWebViewPermissionPolicy.mayGrantAudioCapture(
+        arrayOf(audioCapture, "android.webkit.resource.VIDEO_CAPTURE"), true, embeddedDom, embeddedDom, "file://", audioCapture
+      )
+    )
+  }
+
+  @Test
+  fun `denies origins outside the configured Expo DOM page`() {
+    assertFalse(
+      DomWebViewPermissionPolicy.mayGrantAudioCapture(
+        arrayOf(audioCapture), true, embeddedDom, embeddedDom, "https://example.com", audioCapture
+      )
+    )
+    assertFalse(
+      DomWebViewPermissionPolicy.mayGrantAudioCapture(
+        arrayOf(audioCapture), true, "https://example.com/page", "https://example.com/page", "https://example.com", audioCapture
+      )
+    )
+  }
+
+  @Test
+  fun `denies permission after the web view navigates away from its configured DOM page`() {
+    assertFalse(
+      DomWebViewPermissionPolicy.mayGrantAudioCapture(
+        arrayOf(audioCapture), true, embeddedDom, "file:///android_asset/www.bundle/other.html", "file://", audioCapture
+      )
+    )
+  }
+}

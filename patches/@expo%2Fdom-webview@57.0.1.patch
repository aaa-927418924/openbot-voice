@@ -0,0 +1,62 @@
+// Copyright 2015-present 650 Industries. All rights reserved.
+
+package expo.modules.webview
+
+import java.net.URI
+import java.util.Locale
+
+internal object DomWebViewPermissionPolicy {
+  fun mayGrantAudioCapture(
+    requestedResources: Array<out String>,
+    hasRecordAudioPermission: Boolean,
+    sourceUri: String?,
+    currentUrl: String?,
+    requestOrigin: String?,
+    audioCaptureResource: String
+  ): Boolean {
+    if (!hasRecordAudioPermission || requestedResources.size != 1 || requestedResources[0] != audioCaptureResource) {
+      return false
+    }
+
+    val source = parse(sourceUri) ?: return false
+    val current = parse(currentUrl) ?: return false
+    val origin = parse(requestOrigin) ?: return false
+
+    return isExpoDomSource(source) &&
+      source.rawPath == current.rawPath &&
+      source.rawQuery == current.rawQuery &&
+      hasSameOrigin(source, current) &&
+      hasSameOrigin(source, origin)
+  }
+
+  private fun parse(value: String?): URI? = try {
+    value?.let { if (it == "file://") URI("file:/") else URI(it) }
+  } catch (_: Exception) {
+    null
+  }
+
+  private fun isExpoDomSource(uri: URI): Boolean {
+    if (uri.rawUserInfo != null) return false
+
+    return when (uri.scheme?.lowercase(Locale.ROOT)) {
+      "file" -> uri.rawAuthority.isNullOrEmpty() &&
+        uri.rawPath?.startsWith("/android_asset/www.bundle/") == true
+      "http", "https" -> uri.host != null &&
+        (uri.rawPath == "/_expo/@dom" || uri.rawPath?.startsWith("/_expo/@dom/") == true)
+      else -> false
+    }
+  }
+
+  private fun hasSameOrigin(first: URI, second: URI): Boolean =
+    first.scheme?.equals(second.scheme, ignoreCase = true) == true &&
+      first.rawUserInfo == null && second.rawUserInfo == null &&
+      first.host.equals(second.host, ignoreCase = true) &&
+      effectivePort(first) == effectivePort(second)
+
+  private fun effectivePort(uri: URI): Int = when {
+    uri.port != -1 -> uri.port
+    uri.scheme.equals("http", ignoreCase = true) -> 80
+    uri.scheme.equals("https", ignoreCase = true) -> 443
+    else -> -1
+  }
+}
diff --git a/node_modules/@expo/dom-webview/android/src/test/java/expo/modules/webview/DomWebViewPermissionPolicyTest.kt b/android/src/test/java/expo/modules/webview/DomWebViewPermissionPolicyTest.kt
